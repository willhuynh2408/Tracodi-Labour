# Public site
NEXT_PUBLIC_SITE_URL=https://tracodilabour.vn

# Payload CMS
DATABASE_URL=postgres://tracodi:change-me@postgres:5432/tracodi
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Admin bootstrap is manual:
# open /admin and create the first user after the database is online.

# Lead notification email, optional but recommended
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@example.com
SMTP_PASS=replace-me
EMAIL_FROM=website@example.com
LEAD_NOTIFY_EMAIL=tracodilabour@tracodi.com.vn

# S3-compatible storage, Cloudflare R2 or AWS S3
S3_BUCKET=tracodi-media
S3_REGION=auto
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
